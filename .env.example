# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Neon Postgres ---
# Pooled connection string from the Neon dashboard or the Vercel Neon integration.
# Use a Neon BRANCH for local development, not the production branch.
DATABASE_URL=

# --- Auth.js (next-auth v5) ---
# Generate with: npx auth secret
AUTH_SECRET=
# GitHub OAuth app credentials (Settings > Developer settings > OAuth Apps)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Only needed if Auth.js cannot infer the deployment URL (set to the production origin on Vercel).
# AUTH_URL=

# Comma-separated list of GitHub account emails allowed to sign in (single-user lock).
ALLOWED_EMAILS=

# --- Gemini ---
# Server-side only. Never expose this to the browser.
GEMINI_API_KEY=
# Model used for both question generation and marking. Must accept audio input.
# gemini-3.5-flash-lite is the default because it works on the free tier.
# gemini-4-hydrogen is stronger but its free-tier limit is 5 requests per
# minute, which one practice session exceeds, and it returns 503 under load.
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Quota protection ---
# Requests allowed in any one clock minute, per user. Stops a stuck retry or a
# runaway loop spending the whole day's allowance in seconds. Defaults to 6.
BURST_REQUEST_CAP=6

# Combined daily cap per user across /api/question and /api/evaluate,
# counted per UTC day. Defaults to 40 when unset.
DAILY_REQUEST_CAP=40

# --- Guest mode ---
# Kill switch. Guest routes 404 and the "Try as guest" button disappears
# unless this is exactly "true" (or "1"). Fails CLOSED, like ALLOWED_EMAILS:
# guest mode exposes a paid AI endpoint to the open internet, so it is off
# until you say otherwise. Pages that read it are rendered per request, so
# flipping it takes effect without a redeploy.
GUEST_MODE_ENABLED=false

# Whether the Gemini key is on PAID quota. This changes what the privacy page
# tells guests. Leave false and the page says plainly that Google may use
# submitted audio to improve their products and that human reviewers may see
# it, which is true of the free tier. Set it to true only once billing is
# actually enabled, or the page becomes a false statement.
GEMINI_PAID_TIER=false

# Per-guest-token limits, per UTC day.
GUEST_EVALUATIONS_PER_TOKEN=3
GUEST_QUESTIONS_PER_TOKEN=10

# Per-IP-hash limit, so clearing cookies does not reset the allowance.
GUEST_EVALUATIONS_PER_IP=5

# The one that protects the bill: evaluations per day across ALL guests.
GUEST_GLOBAL_EVALUATIONS=100

# Guest recording ceilings in seconds, enforced on the server. Parts 1 and 3
# are shorter than Part 2's long turn.
GUEST_MAX_SEC_PART13=90
GUEST_MAX_SEC_PART2=120

# Upload ceiling for a guest recording, in bytes. Tighter than the owner's 4 MB.
GUEST_MAX_AUDIO_BYTES=3145728

# Guest token lifetime in hours. Capped at 24 in code whatever is set here.
GUEST_TOKEN_TTL_HOURS=24
