# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Neon Postgres ---
# Pooled connection string from the Neon dashboard or the Vercel Neon integration.
# Use a Neon BRANCH for local development, not the production branch.
DATABASE_URL=

# --- Auth.js (next-auth v5) ---
# Generate with: npx auth secret
AUTH_SECRET=
# GitHub OAuth app credentials (Settings > Developer settings > OAuth Apps)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Only needed if Auth.js cannot infer the deployment URL (set to the production origin on Vercel).
# AUTH_URL=

# Comma-separated list of GitHub account emails allowed to sign in (single-user lock).
ALLOWED_EMAILS=

# --- Gemini ---
# Server-side only. Never expose this to the browser.
GEMINI_API_KEY=
# Model used for both question generation and marking. Must accept audio input.
# gemini-3.5-flash-lite is the default because it works on the free tier.
# gemini-4-hydrogen is stronger but its free-tier limit is 5 requests per
# minute, which one practice session exceeds, and it returns 503 under load.
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Quota protection ---
# Requests allowed in any one clock minute, per user. Stops a stuck retry or a
# runaway loop spending the whole day's allowance in seconds. Defaults to 6.
BURST_REQUEST_CAP=6

# Combined daily cap per user across /api/question and /api/evaluate,
# counted per UTC day. Defaults to 40 when unset.
DAILY_REQUEST_CAP=40
